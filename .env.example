# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Vite only exposes vars prefixed with VITE_ to the browser.

# --- Supabase (frontend) ---
# Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where OAuth redirects back to in local dev (must be in Supabase Auth -> URL config)
VITE_SITE_URL=http://localhost:5173

# --- Edge function secrets (set with: supabase secrets set KEY=value) ---
# These are NOT VITE_ prefixed and never reach the browser.
# SMTP for outbound email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=postmaster@ccentrik.com
# SMTP_PASSWORD=
# SMTP_FROM="Ccentrik Talent Acquisition <no-reply@ccentrik.com>"
#
# Public base URL used to build secure links inside emails
# PUBLIC_SITE_URL=http://localhost:5173
#
# Service-role key is injected automatically into deployed functions as
# SUPABASE_SERVICE_ROLE_KEY — do not set it here.
